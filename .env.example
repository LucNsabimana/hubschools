# Copy this file to .env and fill in your values (used by `netlify dev`).
# NEVER commit .env to GitHub. In production, set these in Netlify:
# Site configuration > Environment variables.

# Google OAuth Client ID (for "Sign in with Google")
# console.cloud.google.com > APIs & Services > Credentials > OAuth client ID
REACT_APP_GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID_HERE

# The private Google Sheet that holds all Pulse data.
# The long string in its URL: https://docs.google.com/spreadsheets/d/THIS_PART_HERE/edit
SHEET_ID=YOUR_SHEET_ID_HERE

# Service account that reads/writes the sheet (server side only, never sent to browsers).
# From the service account's JSON key file: "client_email" and "private_key".
# Paste the private key on one line, keeping the \n sequences exactly as they appear in the JSON.
GOOGLE_SERVICE_ACCOUNT_EMAIL=pulse-data@your-project.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
